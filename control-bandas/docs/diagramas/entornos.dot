digraph entornos {
  rankdir=TB; nodesep=0.4; ranksep=0.75;
  graph [fontname="DejaVu Sans", pad=0.35, bgcolor="white", dpi=170]
  node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#5B6B7B", margin="0.18,0.10"]
  edge [fontname="DejaVu Sans", fontsize=9.5, color="#5B6B7B", arrowsize=0.8]
  dev [label="LOCAL\nDocker Compose\nhttp://localhost:8080\nBD: MariaDB en contenedor\nDatos: de prueba", fillcolor="#E6F0FA", color="#2F6DB5"];
  ci [label="CI (efímero)\nGitHub Actions\nBD: servicio MariaDB\nSe destruye al terminar", fillcolor="#F4F6F8"];
  stg [label="STAGING\nsubdominio en Hostinger\nrama develop\nBD propia (copia anonimizada)\nDespliegue automático", fillcolor="#E8F5E9", color="#2E7D32"];
  prd [label="PRODUCCIÓN\ndominio real en Hostinger\ntag vX.Y.Z (desde main)\nBD real + fotos reales\nDespliegue con aprobación", fillcolor="#DDEFE0", color="#1B5E20", penwidth=2.5];
  dev -> ci [label="git push / PR"];
  ci -> stg [label="merge a develop"];
  stg -> prd [label="release/* → main → tag"];
  prd -> stg [label="rollback: tag anterior", style=dashed, color="#B33A3A", fontcolor="#B33A3A", constraint=false];
}
